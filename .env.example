# ================================================================
# PostgreSQL Connection Configuration
# ================================================================
# กรุณาคัดลอกไฟล์นี้เป็น .env แล้วใส่ Connection String ของ PostgreSQL
#
# ตัวอย่างบริการ Cloud PostgreSQL ฟรีที่แนะนำ:
# 1. Neon (แนะนำ สมัครฟรีที่ neon.tech ภายใน 1 นาที):
#    POSTGRES_URL=postgresql://neondb_owner:npg_xxxx@ep-cool-cloud-12345.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
#
# 2. Supabase (สมัครฟรีที่ supabase.com):
#    POSTGRES_URL=postgresql://postgres.xxxx:your-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
#
# 3. Local PostgreSQL (ในเครื่อง):
#    POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/attendance_db

POSTGRES_URL=

# Port สำหรับ Local Development Server (ค่าเริ่มต้น 8000)
PORT=8000
